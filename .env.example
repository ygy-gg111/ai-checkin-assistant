NEXT_PUBLIC_APP_NAME="AI Check-in Assistant"
NEXT_PUBLIC_DEFAULT_LOCALE="zh-CN"

# Copy this file to .env and replace the credentials with local values.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/ai_checkin"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
UPLOAD_DIR="./uploads"

# Required in production. Store PEM values on one line with newlines encoded as \n.
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
