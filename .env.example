NEXT_PUBLIC_APP_NAME="AI Check-in Assistant"
NEXT_PUBLIC_DEFAULT_LOCALE="zh-CN"

# Copy this file to .env and replace the credentials with local values.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/ai_checkin"
DATABASE_DRIVER="mariadb"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
UPLOAD_DIR="./uploads"
STORAGE_PROVIDER="local"

# Enable these only for the Vercel + TiDB Cloud + R2 deployment.
# DATABASE_DRIVER="tidb-cloud"
# STORAGE_PROVIDER="r2"
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# R2_PUBLIC_BASE_URL="https://media.example.com"

# Required in production. Store PEM values on one line with newlines encoded as \n.
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
